name: {{ deploy_compose_project }}

# Только бот. TLS и reverse proxy — внешний nginx на хосте (см. deploy/nginx/).
# Контейнер слушает loopback хоста: 127.0.0.1:8080 — nginx проксирует /connect
# и /api/calendar/* туда.

services:
  satellite:
    image: ${SATELLITE_IMAGE}
    restart: unless-stopped
    env_file:
      - .env
    environment:
      WEBAPP_HOST: "0.0.0.0"
      WEBAPP_PORT: "8080"
    ports:
      - "127.0.0.1:{{ satellite_host_port }}:8080"
    volumes:
      - satellite-logs:/app/logs
    healthcheck:
      test: ["CMD", "curl", "--fail", "--silent", "http://127.0.0.1:8080/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s

volumes:
  satellite-logs:
