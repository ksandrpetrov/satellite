SATELLITE_IMAGE={{ satellite_image }}
TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
ADMIN_TELEGRAM_IDS={{ admin_telegram_ids }}
TOKEN_ENCRYPTION_KEY={{ token_encryption_key_effective }}

WEBAPP_BASE_URL={{ webapp_base_url }}
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

TZ_NAME={{ tz_name }}
HIDE_ALL_DAY_EVENTS={{ hide_all_day_events | lower }}
HIDE_LUNCH_EVENTS={{ hide_lunch_events | lower }}
LOG_LEVEL={{ log_level }}
BOT_WORKERS={{ bot_workers }}

{% if weather_enabled %}
WEATHER_ENABLED=true
WEATHER_LOCATION={{ weather_location }}
WEATHER_SHOW_NORMAL={{ weather_show_normal | lower }}
{% else %}
WEATHER_ENABLED=false
{% endif %}
