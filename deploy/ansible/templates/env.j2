SATELLITE_IMAGE={{ satellite_image }}
TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
ADMIN_TELEGRAM_IDS={{ admin_telegram_ids }}
TOKEN_ENCRYPTION_KEY={{ token_encryption_key_effective }}
OPENAI_API_KEY={{ openai_api_key | default(ai_existing.OPENAI_API_KEY | default('')) }}
AI_ENABLED={{ ai_enabled | default(ai_existing.AI_ENABLED | default('false')) | lower }}
AI_MODEL={{ ai_model | default(ai_existing.AI_MODEL | default('gpt-6.1-sol')) }}
AI_MONTHLY_LIMIT_USD={{ ai_monthly_limit_usd | default(ai_existing.AI_MONTHLY_LIMIT_USD | default(50)) }}

WEBAPP_BASE_URL={{ webapp_base_url }}
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

TZ_NAME={{ tz_name }}
HIDE_ALL_DAY_EVENTS={{ hide_all_day_events | lower }}
HIDE_LUNCH_EVENTS={{ hide_lunch_events | lower }}
LOG_LEVEL={{ log_level }}
BOT_WORKERS={{ bot_workers }}

{% if weather_enabled %}
WEATHER_ENABLED=true
WEATHER_LOCATION={{ weather_location }}
WEATHER_SHOW_NORMAL={{ weather_show_normal | lower }}
{% else %}
WEATHER_ENABLED=false
{% endif %}
