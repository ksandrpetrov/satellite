# Эталон .env для Docker-деплоя (deploy/docker-compose.yml; nginx — на хосте).
# Ansible шаблонит этот файл из templates/env.j2 + group_vars/all.yml.
# Для ручного compose: скопируйте в `.env` рядом с docker-compose.yml и
# подставьте реальные значения.

TELEGRAM_BOT_TOKEN=replace-me
ADMIN_TELEGRAM_IDS=111111111
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key

WEBAPP_BASE_URL=https://cassinilab.ru/connect
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# legacy; авто-дайджест плана всегда на сегодня (см. docs/configuration.md)
DIGEST_MODE=today
TZ_NAME=Europe/Moscow
HIDE_ALL_DAY_EVENTS=true
HIDE_LUNCH_EVENTS=true

LOG_LEVEL=INFO
BOT_WORKERS=4

WEATHER_ENABLED=true
WEATHER_LOCATION={"name":"Москва","latitude":55.7558,"longitude":37.6173,"timezone":"Europe/Moscow"}
WEATHER_SHOW_NORMAL=true
