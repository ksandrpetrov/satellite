# Копируется Ansible в {{ deploy_dir }}/.env — для ручного compose см. group_vars/all.yml.

TELEGRAM_BOT_TOKEN=replace-me
ADMIN_TELEGRAM_IDS=111111111
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key

