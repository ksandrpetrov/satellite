# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:your-bot-token

# Числовые Telegram user id админов через запятую (не @username).
# Узнать свой id: напишите @userinfobot в Telegram.
ADMIN_TELEGRAM_IDS=111111111

# --- Шифрование пользовательских токенов ---
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key

# --- Telegram Web App (страница «Подключение календаря») ---
# Публичный HTTPS URL за reverse proxy. Telegram открывает именно его.
WEBAPP_BASE_URL=https://your-domain.example/connect
# Bind встроенного HTTP-сервера (внутри процесса бота, отдельный поток).
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# --- Дайджест ---
# На какой день строить автоматический дайджест: today | tomorrow | day_after_tomorrow.
# Время и дни отправки настраиваются каждым пользователем в /settings и хранятся
# в logs/subscriptions.json. Дефолты нового пользователя: weekdays, 09:00, Europe/Moscow.
DIGEST_MODE=tomorrow

# --- Часовой пояс / общие настройки плана ---
TZ_NAME=Europe/Moscow
HIDE_ALL_DAY_EVENTS=true
HIDE_LUNCH_EVENTS=true

# --- Опционально: тюнинг бота ---
# Уровень логирования: DEBUG | INFO | WARNING | ERROR (default INFO)
# LOG_LEVEL=INFO
# Сколько воркеров параллельно обрабатывают сообщения бота (default 4)
# BOT_WORKERS=4
# Таймаут long-polling Telegram getUpdates в секундах (default 30)
# BOT_LONG_POLL_SEC=30
# TTL кэша CalDAV principal+calendars в секундах (default 300). 0 = без кэша.
# CALDAV_CACHE_TTL_SEC=300

# --- Погода (Open-Meteo), опционально ---
# WEATHER_ENABLED=true
# Координаты и пояс: JSON или отдельные WEATHER_LATITUDE / WEATHER_LONGITUDE / WEATHER_TIMEZONE
# WEATHER_LOCATION={"name": "Москва", "latitude": 55.7558, "longitude": 37.6173, "timezone": "Europe/Moscow"}
# Показывать строку и в «спокойный» день (default true). false — только предупреждения (дождь, ветер, жара…)
# WEATHER_SHOW_NORMAL=true
# WEATHER_CACHE_TTL_MINUTES=30
