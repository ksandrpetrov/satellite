# Эталон переменных окружения. Скопируйте в .env и заполните.
#
# `make env` создаст .env из этого файла и сгенерирует TOKEN_ENCRYPTION_KEY.

# --- обязательные --------------------------------------------------------

# Токен Telegram-бота от @BotFather.
TELEGRAM_BOT_TOKEN=replace-me

# Telegram id админов через запятую — могут одобрять заявки на доступ
# и автоматически попадают в approved при первом /start.
ADMIN_TELEGRAM_IDS=111111111

# Fernet-ключ для шифрования пользовательских CalDAV-credentials.
# Сгенерируйте: `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# или `make fernet-key`.
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key

# Публичный HTTPS-URL для кнопки Telegram Web App (не путь к connect.html в коде).
# Должен оканчиваться на `/connect` и обслуживаться reverse-proxy (Traefik/nginx/ngrok),
# который терминирует TLS и проксирует /connect и /api/calendar/* на WEBAPP_HOST:WEBAPP_PORT.
WEBAPP_BASE_URL=https://cassinilab.ru/connect

# --- HTTP сервер веб-приложения ------------------------------------------

# В Docker — 0.0.0.0; локально без Docker — 127.0.0.1.
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# --- поведение дайджеста / часовой пояс ----------------------------------

# today | tomorrow | day_after_tomorrow (на какую дату строим утренний дайджест).
DIGEST_MODE=tomorrow

# Часовой пояс бота и WebApp (Olson tz, например Europe/Moscow).
TZ_NAME=Europe/Moscow

HIDE_ALL_DAY_EVENTS=true
HIDE_LUNCH_EVENTS=true

# --- наблюдаемость / ресурсы ---------------------------------------------

LOG_LEVEL=INFO
BOT_WORKERS=4
BOT_LONG_POLL_SEC=30
CALDAV_CACHE_TTL_SEC=300

# --- погода (опционально) ------------------------------------------------

WEATHER_ENABLED=false
# WEATHER_LOCATION={"name":"Москва","latitude":55.7558,"longitude":37.6173,"timezone":"Europe/Moscow"}
# WEATHER_SHOW_NORMAL=true
# WEATHER_CACHE_TTL_MINUTES=30
